# === Option A: API key mode (official, default) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# === Option B: free Google-cookie mode (consumer Gemini, unofficial) ===
# Use your logged-in gemini.google.com session instead of an API key.
# Image generation + editing only (no video). Extract cookies from browser DevTools:
#   Application > Cookies > https://gemini.google.com
# GEMINI_AUTH_MODE=gemini-web
# GEMINI_SECURE_1PSID=your___Secure-1PSID_cookie_value
# GEMINI_SECURE_1PSIDTS=your___Secure-1PSIDTS_cookie_value
